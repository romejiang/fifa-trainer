; 唯一的工程定义。config_version=5 是 4.7.2 的当前值（core/config/project_settings.h）。
; 不要用 4.8 打开本工程：4.8 会静默改写本文件，把 config/features 升到 "4.8"，
; 那正是 P-01（版本锁死 4.7.2-stable）要防的漂移。注视这里的 "4.7" 就是哨兵。
config_version=5

[application]

config/name="FIFA 花式动作练习器"
run/main_scene="res://src/ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
; user:// 的目录名必须在产生任何用户数据之前定死。发布之后再改等于把老用户的
; user:// 换成一个空目录（覆盖安装会丢配置）；Phase 9 的覆盖安装依赖它保持不变。
; 显示名仍是上面的中文 config/name —— 那是应用名，不是目录名。
config/use_custom_user_dir=true
config/custom_user_dir_name="FifaSkillTrainer"

[display]

; 横屏固定写出来防漂移（默认已是 0）：手机/平板架在手边时不需要转屏。
window/handheld/orientation=1
; 练习时屏幕不能熄；最终承诺在 Phase 7 的反馈闭环里收口。
window/energy_saving/keep_screen_on=true
; 基准视口 1280x720，canvas_items 让 px 在不同 DPI 上语义稳定（RESEARCH §3）。
window/size/viewport_width=393
window/size/viewport_height=852
window/stretch/mode="canvas_items"

[gui]

; 双字体的唯一入口：base = Noto Sans SC 子集，fallbacks = 符号子集（提供 ✗）。
; 资源本身由 tools/make_font_subset.py 的产物拼成，闸门 A 会在关闭系统兜底后
; 逐字符断言这份设置真的够用（T-02-09）。
theme/custom_font="res://assets/fonts/AppFont.tres"

[rendering]

; GL Compatibility 把 minSdk 压回 24（Vulkan 路径强制 29，见 P-03）。
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; 这一行缺了，安卓导出会直接失败：导出器要求 ETC2/ASTC 纹理压缩可导入
; （RESEARCH P1，本机先失败后加上该键才成功）。
textures/vram_compression/import_etc2_astc=true
