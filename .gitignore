# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PyInstaller / local build artifacts
# 必须写 desktop/build/* 而不是 desktop/build/：目录被整体排除后 ! 无法再把脚本捞回来
desktop/dist/
desktop/build/*
!desktop/build/build_windows.ps1
!desktop/build/build_macos.sh

# 移动端产物（Phase 2 起才会有内容，先占位，避免第一次导出就把缓存提交进来）
mobile/.godot/
mobile/build/
mobile/export/
*.apk
# apksigner 的 v4 签名旁文件（RESEARCH P11）：分发时只拷 .apk
*.idsig
# release / debug 密钥库永远不进仓库（T-02-10）
*.keystore
# keytool 的另一种扩展名，与 .keystore 同等对待
*.jks

# Local logs / screenshots
*.log
trainer.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
